# Integration Monitor - Environment Variables
# Copy this file to .env and set all values before running docker compose
# NEVER commit the actual .env file to version control

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=CHANGE-ME-STRONG-DB-PASSWORD

# ─── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-ME-IN-PRODUCTION-USE-256-BIT-RANDOM

# ─── Agent API Keys ────────────────────────────────────────────────────────────
# Comma-separated list. Each agent server gets ONE of these keys.
# Generate with: python -c "import secrets; print(secrets.token_hex(20))"
AGENT_API_KEYS=CHANGE-ME-AGENT-KEY-RIS-APP-01,CHANGE-ME-AGENT-KEY-HIS-APP-01

# ─── Optional: Webhook for BITE alerts ────────────────────────────────────────
# POST the BITE JSON payload to this URL (Teams, Slack, PagerDuty incoming webhook)
# Leave empty to disable
WEBHOOK_URL=

# ─── Optional: Email alerts ───────────────────────────────────────────────────
# SMTP_HOST=smtp.hospital.local
# SMTP_PORT=587
# SMTP_USER=ihm-alerts@hospital.local
# SMTP_PASS=CHANGE-ME
# ALERT_EMAIL_TO=oncall@hospital.local

# ─── Polling / timing ─────────────────────────────────────────────────────────
PROBE_INTERVAL=30           # seconds between TCP/HTTP probes per endpoint
ACK_TIMEOUT=60              # seconds before an outbound message is flagged "timeout"

# ─── Debug (set to false in production) ───────────────────────────────────────
DEBUG=false
